rules_version = '2';

// The client never talks to Firestore directly — all reads/writes go
// through Next.js API routes using the Admin SDK, which bypasses these
// rules entirely. This denies any direct client-side access as
// defense-in-depth.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
